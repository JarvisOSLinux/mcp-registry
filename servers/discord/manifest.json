{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Discord (bot)",
  "description": "Discord through a bot the user makes in Discord's developer portal and adds to their servers: JARVIS lists the servers and channels the bot is in, reads a channel's or thread's recent messages, and posts to it. Use for 'what did people say in #general today?', 'catch me up on the announcements channel', 'post the release notes in #updates' and 'reply to that question in the help thread'. A bot sees only the servers it was added to and the channels its role can view; it cannot read the user's own DMs or other servers. Posts can mention people but never @everyone, @here or a role.",
  "summary": "Read and post in Discord channels and threads through your own Discord bot, in the servers you add it to: catch up on a channel, post an announcement, reply in a thread. Python standard library only; Linux, macOS and Windows.",
  "keywords": [
    "discord",
    "discord bot",
    "discord server",
    "channel",
    "community",
    "chat",
    "post message",
    "read messages",
    "announcements",
    "thread",
    "messaging",
    "guild"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Discord bot MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Discord bot MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "053468c5f1b49a08b53f608df081a4225fc4c073",
    "path": "servers/discord"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "list_servers",
      "description": "The Discord servers the bot is in, and a link that adds it to another",
      "threat_level": "safe"
    },
    {
      "name": "list_channels",
      "description": "The channels and active threads in the bot's servers, by category, with ids and kinds",
      "threat_level": "safe"
    },
    {
      "name": "read_messages",
      "description": "A channel's or thread's recent messages, oldest first, with author, time, attachments and replies",
      "threat_level": "elevated"
    },
    {
      "name": "send_message",
      "description": "Post a message in a channel or thread as the bot; mentions reach people, never @everyone, @here or a role",
      "threat_level": "dangerous"
    }
  ],
  "configurableProperties": [
    {
      "key": "DISCORD_BOT_TOKEN",
      "label": "Bot token",
      "description": "At discord.com/developers/applications choose New Application, open Bot, press Reset Token and copy it here. On the same page switch on Message Content Intent, or the bot reads messages without their text. Then ask JARVIS for the link that adds the bot to your server. Anyone with the token controls the bot.",
      "sensitive": true,
      "required": true
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://discord.com/developers/docs/reference",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/discord"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence",
      "source: maintained in-tree at servers/discord, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, datetime)",
      "network: outbound HTTPS to discord.com only",
      "credentials: a bot token from the server's settings, sent only to discord.com in the Authorization header and never put in a tool result or error",
      "filesystem: none \u2014 no reads or writes outside the interpreter's own imports"
    ],
    "notes": "First-party server maintained in this repository, on Discord's REST API, which is free for bots. A bot token is a much smaller grant than a user account: the bot sees only the servers it was added to and the channels its role can view. Reading message text needs the Message Content intent, which a bot in fewer than 100 servers switches on itself in the developer portal; without it Discord returns messages with no text, and the server says so.",
    "securityNotes": "read_messages is elevated: anyone in a server can post, so message text is third-party text and a prompt-injection surface. Every result says so.\n\nsend_message is dangerous: it posts publicly to a community and cannot be taken back by the model. Its mentions are limited to people (allowed_mentions parse users), so no message can ping @everyone, @here or a role, whatever the model writes. The confirmation shows the channel and the text.\n\nlist_servers and list_channels are safe: they return server and channel names and ids, no message text (channel topics are left out for that reason).\n\nThe token goes only to discord.com, in a header, and is scrubbed from every error. The server stores nothing on disk."
  },
