{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Telegram (bot)",
  "description": "Telegram through a bot the user makes with @BotFather: JARVIS reads what people send the bot and sends messages and files from it. The usual setup is a private chat between the user and their own bot, so JARVIS can message the user's phone ('tell me on Telegram when the backup finishes', 'send me that PDF on Telegram') and read what the user writes back ('any new Telegram messages?'). A bot sees only what is sent to it: it cannot read the user's own chats, and cannot start a chat with anyone who has not messaged it first. Messages it has read are kept locally for 30 days, since Telegram deletes them once read.",
  "summary": "Send yourself Telegram messages and files from JARVIS, and read what you send back, through your own Telegram bot (made with @BotFather in a minute). The bot sees only messages sent to it. Python standard library only; Linux, macOS and Windows.",
  "keywords": [
    "telegram",
    "telegram bot",
    "message me",
    "send to my phone",
    "notify me",
    "phone notification",
    "chat",
    "send message",
    "send file",
    "botfather",
    "messaging",
    "instant message"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Telegram bot MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Telegram bot MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "9f9a5f135d6fbf352cabde1407a738b5aee9b94a",
    "path": "servers/telegram"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "list_chats",
      "description": "The bot's name and link, and the chats that have written to it with their numbers, last message time and unread count",
      "threat_level": "safe"
    },
    {
      "name": "read_messages",
      "description": "Messages people sent the bot, and what the bot sent, oldest first, with sender and time; new ones marked",
      "threat_level": "elevated"
    },
    {
      "name": "send_message",
      "description": "Send a text message from the bot to a chat, by its number, @username or name",
      "threat_level": "dangerous"
    },
    {
      "name": "send_file",
      "description": "Send a file from this computer through the bot, as a document up to 50 MB, with an optional caption",
      "threat_level": "dangerous"
    }
  ],
  "configurableProperties": [
    {
      "key": "TELEGRAM_BOT_TOKEN",
      "label": "Bot token",
      "description": "From @BotFather in Telegram: send it /newbot, answer its two questions (a name, then a username ending in 'bot'), and it replies with the token. Then open your new bot and press Start, so it has a chat with you. Anyone with the token controls the bot.",
      "sensitive": true,
      "required": true
    },
    {
      "key": "TELEGRAM_CHAT_ID",
      "label": "Default chat",
      "description": "Optional. The chat a message goes to when none is named, usually your own chat with the bot. Its number shows in list_chats once you have messaged the bot. Leave empty to name the chat each time.",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://core.telegram.org/bots/api",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/telegram"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence",
      "source: maintained in-tree at servers/telegram, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, datetime)",
      "network: outbound HTTPS to api.telegram.org only",
      "credentials: a bot token from the server's settings, sent only to api.telegram.org and never put in a tool result or error",
      "filesystem: a message store at $XDG_STATE_HOME/jarvis-telegram (%LOCALAPPDATA% on Windows), owner-only; send_file reads the one file it is given"
    ],
    "notes": "First-party server maintained in this repository, on Telegram's Bot API, which is free and needs no review. A bot token is a much smaller grant than a user account: the bot sees only messages sent to it (and in groups, with privacy mode on, only commands, mentions and replies to it), and cannot message anyone who has not messaged it first. Telegram holds a bot's incoming messages for 24 hours until it reads them and deletes them once read, so the server keeps what it read for 30 days.",
    "securityNotes": "read_messages is elevated: anyone who finds the bot can write to it, so message text is third-party text and a prompt-injection surface. Every result says so.\n\nsend_message and send_file are dangerous: they reach other people and cannot be taken back, and send_file can send any file the user can read to any chat the bot is in. The confirmation shows the chat and the text or path.\n\nlist_chats is safe: it returns the bot's own name and the names and numbers of chats, no message text.\n\nThe token is sent only to api.telegram.org, and is scrubbed from every error, since it is part of each request URL. The message store is written owner-only (0600) and holds a month of messages at most."
  },
