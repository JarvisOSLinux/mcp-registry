  "homepage": "https://github.com/MissionSquad/mcp-github",
  "transports": [
    {
      "type": "stdio",
      "command": "node",
      "args": [
        "dist/index.js"
      ],
      "description": "GitHub MCP server (stdio). Requires GitHub token (PAT)."
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/MissionSquad/mcp-github.git",
    "rev": "e312daffca07981c02aa8ca13a9dee82ad51697c"
  },
  "setupScript": "https://raw.githubusercontent.com/JarvisOSLinux/mcp-registry/main/servers/io.github.missionsquad.mcp-github/setup.sh",
  "tools": [
    {
      "name": "create_or_update_file",
      "description": "Create or update a file in a repository.",
      "threat_level": "dangerous"
    },
    {
      "name": "push_files",
      "description": "Push multiple files in a single commit.",
      "threat_level": "dangerous"
    },
    {
      "name": "get_file_contents",
      "description": "Get contents of a file or directory.",
      "threat_level": "elevated"
    },
    {
      "name": "search_repositories",
      "description": "Search GitHub repositories.",
      "threat_level": "safe"
    },
    {
      "name": "create_repository",
      "description": "Create a new repository.",
      "threat_level": "dangerous"
    },
    {
      "name": "create_issue",
      "description": "Create an issue.",
      "threat_level": "elevated"
    },
    {
      "name": "create_pull_request",
      "description": "Create a pull request.",
      "threat_level": "elevated"
    },
    {
      "name": "list_pull_requests",
      "description": "List pull requests.",
      "threat_level": "elevated"
    },
    {
      "name": "merge_pull_request",
      "description": "Merge a pull request.",
      "threat_level": "dangerous"
    },
    {
      "name": "get_pull_request_files",
      "description": "List files changed in a pull request.",
      "threat_level": "elevated"
    }
  ],
  "configurableProperties": [
    {
      "key": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "label": "GitHub Personal Access Token",
      "description": "Token used to call GitHub API. Fine-grained or classic PAT supported depending on operations.",
      "sensitive": true,
      "required": true
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://github.com/MissionSquad/mcp-github"
    ],
    "checks": [
      "license: MIT (upstream)",
      "source: git clone https://github.com/MissionSquad/mcp-github.git",
      "build: yarn install --frozen-lockfile && yarn build (dist/index.js)"
    ],
    "notes": "Tool list in this manifest is a minimal subset for demo/testing. Upstream exposes many more tools (issues/PRs/search/webhooks).",
    "securityNotes": "Powerful GitHub API access. Use least-privilege tokens and prefer fine-grained PATs with scoped permissions."
  },
