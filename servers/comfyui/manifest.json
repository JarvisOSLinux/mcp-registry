{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "JARVIS ComfyUI \u2014 On-Device Image Generation",
  "summary": "Local text-to-image generation via a running ComfyUI instance (Stable Diffusion). Queues a generation workflow, polls until completion, writes the output PNG to disk and returns its file path plus small metadata (dimensions, prompt_id) \u2014 the image bytes are never inlined into the result. Entirely on-device, no cloud API, no data leaves the machine. GPU-dependent: requires a model checkpoint loaded in ComfyUI.",
  "keywords": [
    "image",
    "generation",
    "comfyui",
    "stable-diffusion",
    "diffusion",
    "text-to-image",
    "creative",
    "local",
    "on-device",
    "gpu",
    "art",
    "illustration"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "description": "JARVIS ComfyUI MCP Server (stdio). Stdlib only \u2014 bridges to a local ComfyUI HTTP API."
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "3b42f6203ea6815364568f6d953e900fa7a844e1",
    "path": "servers/comfyui"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "generate_image",
      "description": "Generate an image from a text prompt using a locally running ComfyUI instance. Queues a Stable Diffusion workflow, waits for completion, writes the resulting PNG to the output directory and returns its file path plus small metadata (path, width, height, format, prompt_id). The image bytes are not returned inline \u2014 read the PNG from the returned path. Runs entirely on-device \u2014 no cloud API, no data leaves the machine.",
      "threat_level": "elevated",
      "blocking": true,
      "suggestedRemindAfter": 60
    },
    {
      "name": "list_models",
      "description": "List the model files available in the running ComfyUI instance, grouped by type (checkpoints, loras, vae, etc.). Use to discover valid model filenames for generate_image.",
      "threat_level": "safe"
    },
    {
      "name": "get_queue",
      "description": "Show the current ComfyUI queue: pending and running prompts.",
      "threat_level": "safe"
    },
    {
      "name": "interrupt",
      "description": "Stop the currently running ComfyUI generation.",
      "threat_level": "safe"
    },
    {
      "name": "get_history",
      "description": "Return the most recent generation history from ComfyUI: prompt IDs and output filenames.",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "COMFYUI_URL",
      "label": "ComfyUI Server URL",
      "description": "Base URL of the running ComfyUI instance. Default http://127.0.0.1:8188. Change only if you started ComfyUI on a different host or port.",
      "sensitive": false,
      "required": false,
      "default": "http://127.0.0.1:8188"
    },
    {
      "key": "COMFYUI_OUTPUT_DIR",
      "label": "Generated Image Output Directory",
      "description": "Directory where generated PNGs are written; the tool result returns a path into it, not the image bytes. Defaults to $XDG_DATA_HOME/jarvis/comfyui/ (or ~/.local/share/jarvis/comfyui/), created 0700 if absent.",
      "sensitive": false,
      "required": false,
      "default": "~/.local/share/jarvis/comfyui/"
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://github.com/JarvisOSLinux/mcp-registry/blob/main/servers/comfyui/server.py",
      "https://github.com/JarvisOSLinux/mcp-registry/issues/38"
    ],
    "checks": [
      "license: same as this registry (GPL-3.0), first-party server",
      "source: https://github.com/JarvisOSLinux/mcp-registry.git (path servers/comfyui)",
      "build: none \u2014 Python standard library only (urllib, json, os, re); setup.sh installs nothing",
      "no third-party Python dependencies, no subprocess calls",
      "network: only the COMFYUI_URL host (127.0.0.1:8188 by default); no other outbound calls",
      "filesystem writes: only generated PNGs, written to COMFYUI_OUTPUT_DIR (default ~/.local/share/jarvis/comfyui/, created 0700); the tool result returns the file path, never the image bytes",
      "official-tier review: reviewer YakupAtahanov, 2026-08-14, reference: trust-approved promotion PR (mcp-registry) \u2014 the five TRUST-MODEL \u00a7official requirements are attested by the maintainer applying the trust-approved label to that PR"
    ],
    "notes": "First-party server. Thin HTTP bridge to a locally running ComfyUI instance. Stdlib only. The server itself is low-risk; the GPU and model resources it drives are the user's own hardware. Generated images are written to the output directory and the tool result returns only the file path plus small metadata \u2014 the image bytes never enter the model's context (they would otherwise be 0.5\u20132 MB of base64 per call, the 'Bloated Context' threat).",
    "securityNotes": "All requests go to COMFYUI_URL \u2014 a local endpoint by default. No credentials are required or accepted. A generated image is written to COMFYUI_OUTPUT_DIR (default ~/.local/share/jarvis/comfyui/, created 0700) under a filename derived from the ComfyUI prompt_id, and the MCP response carries only that path plus small metadata (dimensions, prompt_id) \u2014 the image bytes are never inlined, so a large PNG cannot flood the model's context. The interrupt tool can abort an in-progress generation, which is useful if the agent queues something unintended. generate_image blocks for up to 10 minutes waiting for completion; the suggestedRemindAfter hint is 60 seconds so the orchestrator can report progress. The COMFYUI_URL config allows targeting a non-local ComfyUI server \u2014 if changed to a remote URL, generation prompts and images traverse the network unencrypted unless ComfyUI is behind TLS."
  },
