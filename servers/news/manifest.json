{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "News",
  "description": "Headlines from news outlets' own feeds, and news about any topic from outlets worldwide, with no account and no API key. Reads the latest headlines, with a short summary and link, from BBC, The Guardian, NPR, The New York Times, Al Jazeera, DW, France 24, Anadolu Agency, TRT Haber, Ars Technica, The Verge, Hacker News and ScienceDaily, plus any feeds added in the settings; and finds recent articles about a topic through the GDELT Project's worldwide index, falling back to the outlets' own headlines when GDELT is unavailable. Use for 'what's in the news', 'latest technology news', 'what's happening with the election', 'any news about Istanbul today' and 'top stories from the BBC'. Read-only.",
  "summary": "Latest headlines from major news outlets' feeds, and recent articles about any topic from the GDELT Project's worldwide index. No API key and no account; Python standard library only, and portable to Linux, macOS and Windows.",
  "keywords": [
    "breaking news",
    "current events",
    "headlines",
    "latest news",
    "news",
    "politics",
    "rss",
    "science news",
    "technology news",
    "today",
    "world news"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "News MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "News MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "ae1cd615942857d6af8b17dba0983bd299119be7",
    "path": "servers/news"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "get_headlines",
      "description": "Latest headlines from named news outlets' feeds, with summaries and links, newest first",
      "threat_level": "safe"
    },
    {
      "name": "search_news",
      "description": "Recent news articles about a topic from outlets worldwide, most relevant first",
      "threat_level": "safe"
    },
    {
      "name": "list_sources",
      "description": "The news sources headlines can come from, with their topics",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "NEWS_DEFAULT_SOURCES",
      "label": "Default sources",
      "description": "Optional. Which sources 'what's in the news?' reads when none is named, as names separated by commas: 'bbc' (the default), or for example 'bbc-world, aljazeera, trt-haber'. list_sources shows them all.",
      "default": "bbc",
      "sensitive": false,
      "required": false
    },
    {
      "key": "NEWS_FEEDS",
      "label": "Extra feeds",
      "description": "Optional. More RSS or Atom feeds, as name=address pairs separated by commas: 'local=https://example.com/rss.xml, blog=https://example.org/feed'. Names are lower-case letters, digits and hyphens; addresses must be http or https.",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/",
      "https://www.gdeltproject.org/about.html#termsofuse",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/news"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence; headlines and summaries are the outlets' own, passed on with their links as feed readers do",
      "source: maintained in-tree at servers/news, pinned by commit",
      "dependencies: none — Python standard library only (urllib, xml.etree, json, email.utils, concurrent.futures)",
      "network: outbound HTTPS to the built-in outlets' feed addresses and api.gdeltproject.org, plus any feeds the user adds in the settings; never to an address a tool call supplies",
      "credentials: none — public feeds and GDELT's open API",
      "filesystem: an owner-only cache directory (XDG_CACHE_HOME/jarvis-news, %LOCALAPPDATA%\\jarvis-news on Windows) for feeds kept five minutes and GDELT's request spacing; nothing else"
    ],
    "notes": "First-party server maintained in this repository. Feeds are cached for five minutes, so repeated questions do not fetch them again. GDELT's data is free for any use with a citation and link to the GDELT Project, which every search answer carries; its DOC API asks for at most one request every five seconds, kept across every running copy of the server with a lock file; after GDELT refuses for asking too fast the server leaves it alone for three minutes and searches the outlets' own headlines instead, since GDELT blocks an address for a while and a shared network may already have triggered that.",
    "securityNotes": "Every tool is read-only and takes no action in the world.\n\nHeadlines and summaries are third-party text and an injection surface: anyone who can get a story into a feed, or an article into GDELT's index, writes text the model reads. The tools are nevertheless classified safe, as Brave Search's and Wikipedia's are, by maintainer decision (2026-11-06); the tool descriptions tell the model not to treat news text as instructions, and tool output reaches it through Project-JARVIS's provenance boundary.\n\nThe server fetches only named sources: the built-in outlets and feeds the user adds in the settings. No tool takes an address, so the model cannot use it to reach arbitrary URLs or the user's own network. Feeds are read with a 5 MB cap and refused if they declare XML entities. Topic searches disclose the topic to GDELT; feed reads disclose nothing beyond the request itself."
  },
