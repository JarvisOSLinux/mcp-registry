{
  "version": "1.1.0",
  "scope": "system",
  "platforms": [
    "linux"
  ],
  "name": "JARVIS Shell (System)",
  "description": "Run programs and shell scripts with system-level (sudo) privileges, including interactive commands as named PTY jobs (run_job / send_input / read_output / kill_job). Use for package management, system updates, systemd, and any command that requires elevated privileges.",
  "summary": "System-level shell execution for JARVIS. Installed to /usr/share/mcp and runs with sudo access. Use for pacman, apt, systemctl, and other privileged operations; interactive privileged commands run as named PTY jobs answerable mid-run via send_input.",
  "keywords": [
    "shell",
    "command",
    "script",
    "execute",
    "sudo",
    "system",
    "admin",
    "package",
    "pacman",
    "apt",
    "systemd",
    "privileged",
    "interactive",
    "job",
    "pty"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "description": "JARVIS Shell System MCP Server"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "3b42f6203ea6815364568f6d953e900fa7a844e1",
    "path": "servers/jarvis-shell-system"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "execute_command",
      "description": "Execute a program with system privileges and return its stdout, stderr, and exit code",
      "threat_level": "dangerous"
    },
    {
      "name": "execute_script",
      "description": "Execute a multi-line shell script with system privileges via /bin/sh",
      "threat_level": "dangerous"
    },
    {
      "name": "run_job",
      "description": "Run a command that may need interactive input, with system privileges, under a real PTY as a named job. Blocks until the job exits, streaming live output to the task's stderr. ALWAYS dispatch this as a concurrent task WITH a remind_after (30s is the suggested interval): the call parks for as long as the command waits on input, so without a reminder nothing ever reports that a prompt is up. The intended loop: dispatch run_job as a concurrent task; when a REMIND or status tail shows the command waiting on input, call send_input with exactly what the output asked for; never guess input the output did not ask for. Returns the transcript, exit code, and job name. The transcript is what a terminal would have shown (carriage-return redraws collapsed, escape sequences removed) and is capped at its tail, with a truncation marker naming the read_output call that fetches the omitted head.",
      "threat_level": "dangerous",
      "blocking": true,
      "suggestedRemindAfter": 30
    },
    {
      "name": "send_input",
      "description": "Send text verbatim to a running job's terminal (the caller supplies the trailing newline). Returns immediately with a delivery confirmation. Send only what the job's output actually asked for.",
      "threat_level": "dangerous"
    },
    {
      "name": "read_output",
      "description": "Read a job's output so far plus its running/exited state, mid-run or after exit; carries the exit code once the job is done. The output is sterilized the same way as run_job's transcript, and optional 'tail'/'offset' read just a window of it — 'tail' alone gives the last N characters, which is where an unanswered prompt sits.",
      "threat_level": "safe"
    },
    {
      "name": "kill_job",
      "description": "Terminate a running job's whole process group (SIGTERM, escalating to SIGKILL after a short grace) and report what happened.",
      "threat_level": "elevated"
    }
  ],
