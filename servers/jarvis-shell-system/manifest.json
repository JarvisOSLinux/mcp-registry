{
  "version": "1.0.0",
  "scope": "system",
  "platforms": [
    "linux"
  ],
  "name": "JARVIS Shell (System)",
  "description": "Run programs and shell scripts with system-level (sudo) privileges. Use for package management, system updates, systemd, and any command that requires elevated privileges.",
  "summary": "System-level shell execution for JARVIS. Installed to /usr/share/mcp and runs with sudo access. Use for pacman, apt, systemctl, and other privileged operations.",
  "keywords": [
    "shell",
    "command",
    "script",
    "execute",
    "sudo",
    "system",
    "admin",
    "package",
    "pacman",
    "apt",
    "systemd",
    "privileged"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "description": "JARVIS Shell System MCP Server"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "path": "servers/jarvis-shell-system"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "execute_command",
      "description": "Execute a program with system privileges and return its stdout, stderr, and exit code"
    },
    {
      "name": "execute_interactive",
      "description": "Execute a program with system privileges under a PTY and answer its prompts live via MCP elicitation (falls back to a closed-stdin needs_input report when the client cannot answer)"
    },
    {
      "name": "execute_script",
      "description": "Execute a multi-line shell script with system privileges via /bin/sh"
    }
  ],
