{
  "version": "1.1.0",
  "scope": "system",
  "platforms": [
    "linux"
  ],
  "name": "JARVIS Shell (System)",
  "description": "Run programs and shell scripts with system-level (sudo) privileges, including interactive commands as named PTY jobs (run_job / send_input / read_output / kill_job). Use for package management, system updates, systemd, and any command that requires elevated privileges.",
  "summary": "Run commands as root on the computer JARVIS runs on: applying system updates and upgrades (pacman -Syu, apt upgrade, dnf upgrade), installing and removing packages, starting, stopping and restarting systemd services, and other administrator work; every command asks for the administrator password. Only checking whether updates exist needs no root (jarvis-shell-mcp). Installed to /usr/share/mcp; interactive commands (a package manager's [Y/n]) run as named PTY jobs answerable mid-run via send_input",
  "keywords": [
    "admin",
    "administrator",
    "apt",
    "command",
    "dnf",
    "execute",
    "install package",
    "interactive",
    "job",
    "package",
    "pacman",
    "privileged",
    "pty",
    "remove package",
    "restart service",
    "root",
    "script",
    "shell",
    "sudo",
    "system",
    "system update",
    "systemd",
    "update",
    "upgrade",
    "yay"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "description": "JARVIS Shell System MCP Server"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "3b42f6203ea6815364568f6d953e900fa7a844e1",
    "path": "servers/jarvis-shell-system"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "execute_command",
      "description": "Execute a program with system privileges and return its stdout, stderr, and exit code",
      "threat_level": "dangerous"
    },
    {
      "name": "execute_script",
      "description": "Execute a multi-line shell script with system privileges via /bin/sh",
      "threat_level": "dangerous"
    },
    {
      "name": "run_job",
      "description": "Run a command that may need interactive input, with system privileges, under a real PTY as a named job. Blocks until the job exits, streaming live output to the task's stderr. ALWAYS dispatch this as a concurrent task WITH a remind_after (30s is the suggested interval): the call parks for as long as the command waits on input, so without a reminder nothing ever reports that a prompt is up. The intended loop: dispatch run_job as a concurrent task; when a REMIND or status tail shows the command waiting on input, call send_input with exactly what the output asked for; never guess input the output did not ask for. Returns the transcript, exit code, and job name. The transcript is what a terminal would have shown (carriage-return redraws collapsed, escape sequences removed) and is capped at its tail, with a truncation marker naming the read_output call that fetches the omitted head.",
      "threat_level": "dangerous",
      "blocking": true,
      "suggestedRemindAfter": 30
    },
    {
      "name": "send_input",
      "description": "Send text verbatim to a running job's terminal (the caller supplies the trailing newline). Returns immediately with a delivery confirmation. Send only what the job's output actually asked for.",
      "threat_level": "dangerous"
    },
    {
      "name": "read_output",
      "description": "Read a job's output so far plus its running/exited state, mid-run or after exit; carries the exit code once the job is done. The output is sterilized the same way as run_job's transcript, and optional 'tail'/'offset' read just a window of it \u2014 'tail' alone gives the last N characters, which is where an unanswered prompt sits.",
      "threat_level": "safe"
    },
    {
      "name": "kill_job",
      "description": "Terminate a running job's whole process group (SIGTERM, escalating to SIGKILL after a short grace) and report what happened.",
      "threat_level": "elevated"
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://github.com/JarvisOSLinux/mcp-registry/blob/main/servers/jarvis-shell-system/server.py",
      "https://github.com/JarvisOSLinux/mcp-registry/blob/main/servers/jarvis-shell-system/setup.sh"
    ],
    "checks": [
      "license: same as this registry (GPL-3.0), first-party server",
      "source: https://github.com/JarvisOSLinux/mcp-registry.git (path servers/jarvis-shell-system)",
      "build: none \u2014 Python standard library only; setup.sh installs nothing",
      "official-tier review: reviewer YakupAtahanov, 2026-08-14, reference: trust-approved promotion PR (mcp-registry) \u2014 the five TRUST-MODEL \u00a7official requirements are attested by the maintainer applying the trust-approved label to that PR"
    ],
    "notes": "First-party server, system scope. Shares its interactive-command implementation with jarvis-shell (the shared blocks are enforced byte-identical by scripts/selftest_jobs.py); installed to /usr/share/mcp for pacman, systemctl and other privileged operations, with interactive privileged commands run as named PTY jobs answerable via send_input.",
    "securityNotes": "System-scope shell: invoked through dmcp's elevation path, its tools run as root, so every call is equivalent to a root shell command. TLA confirmation upstream is the per-command consent boundary; polkit provides proof-of-presence per elevation window. Command output, including PTY job transcripts, is untrusted text and can carry prompt injection."
  },
