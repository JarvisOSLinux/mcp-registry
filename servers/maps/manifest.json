{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Maps (OpenStreetMap)",
  "description": "Places, addresses, what is nearby, and routes with distance and travel time by car, bike or on foot, from OpenStreetMap's public services (Nominatim for places, the FOSSGIS routing servers for routes), with no account and no API key. Finds a place or address, names the address at coordinates, lists places of a kind near a location nearest first with opening hours where mapped, and routes between two places with turn-by-turn steps on request. Use for 'how long does it take to drive to the airport', 'how far is Ankara from Istanbul', 'find a pharmacy near Moda', 'is there a cafe near the station' and 'where is the Eiffel Tower'. Read-only. Keeps the services' usage rules: one request a second, cached answers, attribution.",
  "summary": "Find places and addresses, search what is nearby, and get routes with distance and travel time by car, bike or foot, from OpenStreetMap. No API key and no account; Python standard library only, and portable to Linux, macOS and Windows.",
  "keywords": [
    "address",
    "cafe",
    "directions",
    "distance",
    "driving",
    "geocode",
    "map",
    "nearby",
    "openstreetmap",
    "pharmacy",
    "places",
    "restaurant",
    "route",
    "travel time",
    "walking"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Maps MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Maps MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "768c0cf7f6bf83bc302ce48d63cb0a8f638d1a5e",
    "path": "servers/maps"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "find_place",
      "description": "Find places by name or address: full address, kind, coordinates and a map link",
      "threat_level": "safe"
    },
    {
      "name": "reverse_geocode",
      "description": "The address at a latitude and longitude",
      "threat_level": "safe"
    },
    {
      "name": "find_nearby",
      "description": "Places of a kind near a location, nearest first, with distance and opening hours where mapped",
      "threat_level": "safe"
    },
    {
      "name": "get_route",
      "description": "Distance and travel time between two places by car, bike or foot, with turn-by-turn steps on request",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "MAPS_HOME",
      "label": "Home location",
      "description": "Optional. Where routes start and nearby searches look when no place is given, so 'how long to the airport?' works. A place name or 'latitude,longitude'. For privacy, a nearby landmark or a pair of coordinates rounded to two decimals is enough; a name is looked up once on OpenStreetMap's Nominatim and then cached.",
      "sensitive": false,
      "required": false
    },
    {
      "key": "MAPS_NOMINATIM_URL",
      "label": "Place search service",
      "description": "Optional. The Nominatim service for places and addresses. Defaults to OpenStreetMap's public one, https://nominatim.openstreetmap.org, which is for light use under its policy (https://operations.osmfoundation.org/policies/nominatim/). Set a self-hosted or commercial Nominatim here to use that instead.",
      "sensitive": false,
      "required": false
    },
    {
      "key": "MAPS_ROUTING_URL",
      "label": "Routing service",
      "description": "Optional. The OSRM routing service. Defaults to the FOSSGIS servers, https://routing.openstreetmap.de/routed-{mode}, where {mode} becomes car, bike or foot. A self-hosted OSRM serving one mode is given without {mode}.",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://operations.osmfoundation.org/policies/nominatim/",
      "https://fossgis.de/arbeitsgruppen/osm-server/nutzungsbedingungen/",
      "https://www.openstreetmap.org/copyright",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/maps"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence; the data it returns is OpenStreetMap's, ODbL, and every answer says so",
      "source: maintained in-tree at servers/maps, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, hashlib, math)",
      "network: outbound HTTPS to nominatim.openstreetmap.org and routing.openstreetmap.de only, unless the settings name other services",
      "credentials: none \u2014 the public services need no account; the User-Agent names this server and its repository, as their policies ask",
      "filesystem: an owner-only cache directory (XDG_CACHE_HOME/jarvis-maps, %LOCALAPPDATA%\\jarvis-maps on Windows) for answers kept 30 days and the one-request-a-second lock; nothing else"
    ],
    "notes": "First-party server maintained in this repository. Its usage of the public services was a maintainer decision (2026-11-06), on condition that it keeps their rules on every call: at most one request a second per service across every running copy (a lock file and timestamp in the cache directory), an identifying User-Agent, places and addresses cached for 30 days, no search-as-you-type or bulk queries, and attribution in every answer. Those services are run by volunteers for light use and may withdraw access at any time; the service addresses are settings so a self-hosted or commercial instance can take over. If JARVIS's users grow beyond light use, they should. Routes come from OSRM and have no live traffic. The Overpass API was not used for nearby search: its policy asks apps not to rely on the public instances.",
    "securityNotes": "Every tool is read-only and takes no action in the world: the server sends a place name or coordinates to a map service and returns places and numbers. It touches no filesystem beyond its own cache directory.\n\nPlace names, addresses, opening hours and websites come from OpenStreetMap, which anyone can edit, so they are third-party text and an injection surface. The tools are classified safe, as Brave Search's and Wikipedia's are, by maintainer decision (2026-11-06).\n\nQueries disclose to the map services what the user looks for and where: place names, and coordinates for routes. Nominatim's policy asks for no personal data in queries, so the home location setting suggests a landmark or rounded coordinates rather than a street address. The service addresses in the settings are fetched from as given: a user who sets one is choosing to send these queries there."
  },
