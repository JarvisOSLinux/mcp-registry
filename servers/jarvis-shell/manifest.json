{
  "version": "1.0.0",
  "scope": "user",
  "name": "JARVIS Shell",
  "description": "Run programs and shell scripts as the current user. Use for git, python, file operations, and any command that does not require elevated privileges.",
  "summary": "User-level shell execution for JARVIS. Runs programs and scripts as the logged-in user. No sudo \u2014 use jarvis-shell-system-mcp for privileged commands.",
  "keywords": [
    "shell",
    "command",
    "script",
    "execute",
    "run",
    "user"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "description": "JARVIS Shell MCP Server"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "path": "servers/jarvis-shell"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "execute_command",
      "description": "Execute a program and return its stdout, stderr, and exit code"
    },
    {
      "name": "execute_script",
      "description": "Execute a multi-line shell script via /bin/sh and return its output"
    }
  ],
