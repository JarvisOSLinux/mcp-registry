      "threat_level": "safe"
    },
    {
      "name": "notion-search-sessions",
      "description": "Search past Custom Agent sessions.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-get-session-status",
      "description": "Get a Custom Agent session's current status.",
      "threat_level": "safe"
    },
    {
      "name": "notion-list-session-events",
      "description": "List the events of a Custom Agent session.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-read-session-event",
      "description": "Read one event of a Custom Agent session.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-wait-session",
      "description": "Wait for a Custom Agent session to finish.",
      "threat_level": "safe"
    },
    {
      "name": "notion-spawn-session",
      "description": "Start a Custom Agent session. The agent acts in the workspace, and its connected tools, on its own.",
      "threat_level": "dangerous"
    },
    {
      "name": "notion-send-message-to-session",
      "description": "Send a follow-up instruction to a running Custom Agent session.",
      "threat_level": "dangerous"
    },
    {
      "name": "notion-stop-session",
      "description": "Stop a running Custom Agent session.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-get-self",
      "description": "Get the connected workspace and the signed-in user's name and email.",
      "threat_level": "safe"
    },
    {
      "name": "notion-check-mcp-next-steps",
      "description": "Follow-up guidance Notion asks for after certain fetch results.",
      "threat_level": "safe"
    },
    {
      "name": "notion-show-advanced-analysis-next-steps",
      "description": "Explains what a cross-database query needs when the plan lacks it.",
      "threat_level": "safe"
    },
    {
      "name": "notion-list-favorite-pages",
      "description": "List the user's favorite pages and databases.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-list-private-pages",
      "description": "List the top-level pages in the user's Private section.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-list-recent-pages",
      "description": "List pages the user viewed recently.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-list-shared-pages",
      "description": "List pages and databases shared directly with the user.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-memory-search",
      "description": "Search memories that the user's connected agents saved in earlier sessions.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-query-multiple-data-sources",
      "description": "Run a read-only SQL query across several databases (Business or Enterprise).",
      "threat_level": "elevated"
    },
    {
      "name": "notion-get-file-download-urls",
      "description": "Get signed download URLs for files that fetched pages reference.",
      "threat_level": "elevated"
    },
    {
      "name": "notion-get-enabled-skills",
