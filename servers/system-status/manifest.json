{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux"
  ],
  "name": "System Status",
  "description": "What an agent operating this machine needs to know about it. One call orients you like neofetch -- OS, kernel, the distro's package manager, init system, VM or container, the user and whether their screen is locked, local time and timezone, uptime, CPU, GPUs, memory, battery and disk. Another checks everything that commonly goes wrong and reports only what needs attention: nearly full or read-only disks, memory stalls, CPU overload, overheating, low or worn battery, failed services, a pending reboot after a kernel upgrade, captive portals. Plus detail on battery, CPU, memory, disks, network, top processes, temperatures and failed services. Use for 'how much battery do I have', 'what's using my CPU', 'how much disk space is left', 'am I online', 'why is my computer slow', 'what time is it'. Read-only; makes no network connections.",
  "summary": "System information and health for the machine JARVIS runs on: OS and package manager, battery, CPU, memory, disk, network, processes, temperatures and failed services, plus a health check that reports only what is wrong. Read-only, local, no network access.",
  "keywords": [
    "battery",
    "connectivity",
    "cpu",
    "disk space",
    "failed services",
    "hardware",
    "health check",
    "internet connection",
    "ip address",
    "kernel",
    "memory",
    "neofetch",
    "network",
    "online",
    "os version",
    "overheating",
    "package manager",
    "processes",
    "ram",
    "reboot",
    "storage",
    "system info",
    "temperature",
    "time",
    "timezone",
    "uptime",
    "wifi"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux"
      ],
      "description": "System Status MCP Server"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "dcd2af1e528deca62b28993554f548fd5517e951",
    "path": "servers/system-status"
  },
  "setupScript": "setup.sh",
  "tools": [
    {
      "name": "get_system_overview",
      "description": "Orient on this machine: OS, kernel, the distro's package manager, init system, VM or container, user and whether the screen is locked, local time and timezone, uptime, CPU, GPUs, memory, battery, root disk and power profile",
      "threat_level": "safe"
    },
    {
      "name": "get_system_health",
      "description": "Check disks, memory, swap, CPU load and boost, temperatures, battery, failed services, pending reboot, clock sync and connectivity; report only what needs attention, most urgent first",
      "threat_level": "safe"
    },
    {
      "name": "get_battery",
      "description": "Battery charge, charging state, time to empty or full, power draw, health and cycle count, AC power, and wireless peripheral batteries",
      "threat_level": "safe"
    },
    {
      "name": "get_cpu",
      "description": "CPU model, cores, turbo boost state, sampled usage overall and per core, I/O wait, load averages, clock speeds, governor and package temperature",
      "threat_level": "safe"
    },
    {
      "name": "get_memory",
      "description": "RAM total and available, swap devices distinguishing zram from disk swap, and memory pressure stall time",
      "threat_level": "safe"
    },
    {
      "name": "get_disks",
      "description": "Free and used space per physical drive with all its mount points, counting btrfs subvolumes once, and read-only mounts",
      "threat_level": "safe"
    },
    {
      "name": "get_network",
      "description": "Online, captive portal or offline; primary interface, local IP and gateway; interfaces labelled physical or virtual; Wi-Fi network and signal; DNS servers",
      "threat_level": "safe"
    },
    {
      "name": "get_top_processes",
      "description": "Processes using the most CPU or memory, with PID, user, CPU percent and memory; command lines only on request",
      "threat_level": "safe"
    },
    {
      "name": "get_temperatures",
      "description": "Every temperature sensor with its critical point, and the hottest reading, with placeholder values filtered out",
      "threat_level": "safe"
    },
    {
      "name": "get_failed_services",
      "description": "Failed systemd units, system-wide and for the user, with the commands to investigate each",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [],
  "trust": {
    "reviewReferences": [
      "https://www.kernel.org/doc/html/latest/filesystems/proc.html",
      "https://www.kernel.org/doc/html/latest/accounting/psi.html",
      "https://www.kernel.org/doc/html/latest/power/power_supply_class.html",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/system-status"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence",
      "source: maintained in-tree at servers/system-status, pinned by commit",
      "dependencies: none -- Python standard library only",
      "reads: /proc, /sys, /etc/os-release, /etc/resolv.conf, /run; asks ip, systemctl, timedatectl, loginctl, nmcli, systemd-detect-virt and powerprofilesctl what they already know",
      "writes: nothing",
      "network: none. The primary route comes from the kernel routing table (`ip route get`), which sends no packet; there is no public-IP lookup",
      "credentials: none",
      "tests: scripts/selftest_system_status.py exercises the parsing against synthetic machines in CI"
    ],
    "notes": "First-party server maintained in this repository. Linux-only: every source is a Linux kernel interface, and macOS or Windows would each need their own backend rather than a port. Optional tools that are missing (NetworkManager, systemd) narrow the answer instead of failing it.",
    "securityNotes": "Read-only. The server writes nothing, changes no setting, starts nothing and opens no network connection, so all ten tools are classified safe.\n\nWhat it returns is information about this machine and its user: hostname, username, local IP addresses, the Wi-Fi network name, and the names of running processes. When JARVIS uses a hosted model, that information goes to the model provider as part of the conversation, like anything else a tool returns. Two things are withheld for that reason: MAC addresses are never reported, being a stable hardware fingerprint no user question needs; and full process command lines are returned only when include_command_line is set, because they can contain passwords or tokens passed as arguments. That is a default, not a control -- the model chooses the parameter -- and the tool description tells it to ask only when a process name is not enough."
  },
