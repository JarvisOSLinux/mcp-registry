{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Weather (Open-Meteo)",
  "description": "Weather and air quality from Open-Meteo, with no account and no API key. Current conditions, a daily forecast out to 16 days, an hour-by-hour forecast out to seven, and current air quality with the European AQI band in words. Place names are geocoded automatically, so a question about a city is a single call; a separate lookup is available for choosing between same-named places. Use for 'what is the weather', 'will it rain this afternoon', 'what is it like in Tokyo', 'do I need a coat tomorrow', and 'is the air bad today'. Read-only: it sends a latitude and longitude to a public API and returns numbers.",
  "summary": "Current weather, daily and hourly forecasts, and air quality from Open-Meteo. No API key and no account; Python standard library only, and portable to Linux, macOS and Windows.",
  "keywords": [
    "air quality",
    "climate",
    "forecast",
    "humidity",
    "open-meteo",
    "precipitation",
    "rain",
    "snow",
    "sunrise",
    "sunset",
    "temperature",
    "uv index",
    "weather",
    "wind"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Weather MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Weather MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "fdbe754c1da1efb0c5de63da404a0428ba558999",
    "path": "servers/weather"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "find_location",
      "description": "Search places by name and return coordinates, country, region, timezone and population, for disambiguating between same-named places",
      "threat_level": "safe"
    },
    {
      "name": "get_current_weather",
      "description": "Current conditions at a place or coordinate: temperature, apparent temperature, humidity, precipitation, cloud cover, wind, and the weather code in words",
      "threat_level": "safe"
    },
    {
      "name": "get_forecast",
      "description": "Daily forecast out to 16 days: high and low temperature, precipitation total and probability, max wind, UV index, sunrise and sunset",
      "threat_level": "safe"
    },
    {
      "name": "get_hourly_forecast",
      "description": "Hour-by-hour forecast out to seven days from the current hour: temperature, precipitation and its probability, wind and humidity",
      "threat_level": "safe"
    },
    {
      "name": "get_air_quality",
      "description": "Current air quality: European and US AQI, PM10, PM2.5, ozone, nitrogen dioxide, sulphur dioxide and carbon monoxide, with the European AQI band in words",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "WEATHER_DEFAULT_LOCATION",
      "label": "Default location",
      "description": "Optional. A place name used when a tool is called with no location, so 'what is the weather?' works with no argument. Example: 'Istanbul' or 'Austin, Texas'. Leave empty to require a location on every call.",
      "sensitive": false,
      "required": false
    },
    {
      "key": "WEATHER_UNITS",
      "label": "Units",
      "description": "Optional. 'metric' (Celsius, km/h, mm) or 'imperial' (Fahrenheit, mph, inches). Defaults to metric. Any tool call may override it with its own units argument.",
      "default": "metric",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://open-meteo.com/en/docs",
      "https://open-meteo.com/en/terms",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/weather"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence",
      "source: maintained in-tree at servers/weather, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, datetime)",
      "network: outbound HTTPS to api.open-meteo.com, geocoding-api.open-meteo.com and air-quality-api.open-meteo.com only",
      "credentials: none \u2014 Open-Meteo requires no account or API key for non-commercial use",
      "filesystem: no reads or writes outside the interpreter's own imports"
    ],
    "notes": "First-party server maintained in this repository. Open-Meteo's free tier is for non-commercial use and is rate-limited rather than key-gated; a deployment that exceeds it needs Open-Meteo's commercial plan, which this server does not configure.",
    "securityNotes": "Every tool is read-only and takes no action in the world: the server sends a latitude and longitude to a public API and returns numbers, reads no user data, and touches no filesystem. All five tools are therefore classified safe.\n\nThe one residual is that fetched content enters the model's context, which is an injection surface in principle. It is judged negligible here because the response is structured numerics from a fixed vendor, and the only free text \u2014 place names from find_location \u2014 comes from Open-Meteo's curated geocoding dataset rather than from user-submitted content.\n\nQueries do disclose to Open-Meteo which places the user asks about, including a configured default location. No identifier is sent beyond the request itself."
  },
