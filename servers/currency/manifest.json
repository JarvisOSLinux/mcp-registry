{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Currency (Frankfurter)",
  "description": "Exchange rates and money conversion from Frankfurter, with no account and no API key: about 160 currencies from central banks and other official sources, a few dozen cryptocurrencies and four precious metals, published daily, with history back to 1999 for most currencies. Converts an amount into one or more currencies at the latest rate or a past date's, lists a currency's rates, shows how one currency moved against another over a period, and finds a currency's code by name. Use for 'how much is 250 dollars in lira', 'what is the euro at today', 'how has the yen moved this year', 'what was the pound worth in 2020' and 'what is bitcoin in dollars'. Read-only: it asks a public API for numbers and returns them; it moves no money.",
  "summary": "Convert money and look up exchange rates, today's or historical, for about 160 currencies plus cryptocurrencies and precious metals, from Frankfurter. No API key and no account; Python standard library only, and portable to Linux, macOS and Windows.",
  "keywords": [
    "bitcoin",
    "conversion",
    "convert money",
    "crypto",
    "currency",
    "dollar",
    "euro",
    "exchange rate",
    "forex",
    "frankfurter",
    "gold",
    "lira",
    "money",
    "pound",
    "yen"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Currency MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Currency MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "557ed92c4fc7d433b6902dd9aba0a9a02ef05a3d",
    "path": "servers/currency"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "convert",
      "description": "Convert an amount from one currency into one or more others at the latest daily rate or a past date's, by code or currency name",
      "threat_level": "safe"
    },
    {
      "name": "get_rates",
      "description": "Exchange rates of one base currency against others, latest or on a past date",
      "threat_level": "safe"
    },
    {
      "name": "get_rate_history",
      "description": "How one currency moved against another over a period: first and last rate, change, low and high, and the series",
      "threat_level": "safe"
    },
    {
      "name": "list_currencies",
      "description": "Find currency, cryptocurrency and metal codes by name, with symbols and how far back their history goes",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "CURRENCY_HOME",
      "label": "Home currency",
      "description": "Optional. The currency a conversion goes into when no target is named, so 'how much is 100 euros?' answers in it. A code or a name, e.g. 'TRY' or 'USD'. Leave empty to require the currency on every call.",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://frankfurter.dev",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/currency"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence",
      "source: maintained in-tree at servers/currency, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, datetime, math)",
      "network: outbound HTTPS to api.frankfurter.dev only",
      "credentials: none \u2014 Frankfurter requires no account or API key",
      "filesystem: no reads or writes outside the interpreter's own imports"
    ],
    "notes": "First-party server maintained in this repository. Frankfurter is free with no quota and rate-limits only against abuse; its blended rates may be used commercially. It is open source and self-hostable, should the public instance go away.",
    "securityNotes": "Every tool is read-only and takes no action in the world: the server asks a public API for exchange rates and returns numbers, reads no user data, touches no filesystem and moves no money. All four tools are therefore classified safe.\n\nFetched content enters the model's context, which is an injection surface in principle. It is judged negligible here: the answers are numbers from a fixed vendor, and the only free text, currency names and symbols, comes from Frankfurter's curated list.\n\nThe rates are mid-market reference rates, which every answer says, so a conversion is not read as the amount a bank or card would pay. Queries disclose to Frankfurter which currencies the user asks about; no identifier is sent beyond the request itself."
  },
