{
  "version": "1.0.0",
  "scope": "user",
  "platforms": [
    "linux",
    "darwin",
    "windows"
  ],
  "name": "Wikipedia",
  "description": "Look things up on Wikipedia, in any of its languages, with no account and no API key. Searches for articles, gives an article's lead (a one-line description and the opening paragraph) for 'who is' and 'what is' questions, reads a whole article or one section of it, and lists what happened on a day in history. A title with several meanings comes back with the likeliest articles to choose from. Use for 'who was Alan Turing', 'what is a black hole', 'tell me about the history of Istanbul', 'what happened on this day' and 'when was the Eiffel Tower built'. Read-only: it reads public encyclopedia text and returns it with the article's address and licence.",
  "summary": "Search Wikipedia and read article summaries, full articles by section, and what happened on this day in history, in any language. No API key and no account; Python standard library only, and portable to Linux, macOS and Windows.",
  "keywords": [
    "biography",
    "definition",
    "encyclopedia",
    "facts",
    "history",
    "knowledge",
    "look up",
    "on this day",
    "reference",
    "what is",
    "who is",
    "wikipedia"
  ],
  "homepage": "https://github.com/JarvisOSLinux/mcp-registry",
  "transports": [
    {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "platforms": [
        "linux",
        "darwin"
      ],
      "description": "Wikipedia MCP Server (POSIX)"
    },
    {
      "type": "stdio",
      "command": "python",
      "args": [
        "server.py"
      ],
      "platforms": [
        "windows"
      ],
      "description": "Wikipedia MCP Server (Windows; python.exe, not python3)"
    }
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/JarvisOSLinux/mcp-registry.git",
    "rev": "63354d92ba17b83f64614c38825982c8bc45d815",
    "path": "servers/wikipedia"
  },
  "setupScript": "setup.sh",
  "setupScriptWindows": "setup.ps1",
  "tools": [
    {
      "name": "search",
      "description": "Search Wikipedia for articles matching a query: titles, one-line descriptions and an excerpt",
      "threat_level": "safe"
    },
    {
      "name": "get_summary",
      "description": "The lead of a Wikipedia article, for who-is and what-is questions; several meanings come back as choices",
      "threat_level": "safe"
    },
    {
      "name": "get_article",
      "description": "The text of a Wikipedia article with its sections, or one section by name",
      "threat_level": "safe"
    },
    {
      "name": "on_this_day",
      "description": "What happened on a day of the year in history: events, births, deaths or holidays",
      "threat_level": "safe"
    }
  ],
  "configurableProperties": [
    {
      "key": "WIKIPEDIA_LANGUAGE",
      "label": "Language",
      "description": "Optional. The Wikipedia to read when a call names none, as a language code: 'en' (the default), 'tr', 'de', 'simple' for Simple English. Any call can ask for another language.",
      "default": "en",
      "sensitive": false,
      "required": false
    }
  ],
  "trust": {
    "reviewReferences": [
      "https://www.mediawiki.org/wiki/Wikimedia_APIs/Rate_limits",
      "https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy",
      "https://github.com/JarvisOSLinux/mcp-registry/tree/main/servers/wikipedia"
    ],
    "checks": [
      "license: server code is first-party, under this repository's licence; the text it returns is Wikipedia's, CC BY-SA 4.0, and every answer says so",
      "source: maintained in-tree at servers/wikipedia, pinned by commit",
      "dependencies: none \u2014 Python standard library only (urllib, json, html, datetime)",
      "network: outbound HTTPS to <language>.wikipedia.org only; the language is checked to be a bare code before it becomes a host name",
      "credentials: none \u2014 anonymous reads, identified by a User-Agent naming this server and its repository, as Wikimedia's policy asks",
      "filesystem: no reads or writes outside the interpreter's own imports"
    ],
    "notes": "First-party server maintained in this repository. Wikimedia rate-limits anonymous clients that identify themselves to 200 requests a minute, far above what one person asking questions sends; a 429 is reported with the wait Wikipedia asks for.",
    "securityNotes": "Every tool is read-only and takes no action in the world: the server reads public encyclopedia text and returns it, reads no user data and touches no filesystem.\n\nWikipedia is written by anyone, so what comes back is third-party text and an injection surface: a vandalised article could carry instructions aimed at the model. The tools are nevertheless classified safe, as Brave Search's are, by maintainer decision (2026-11-06): rating every lookup elevated would ask for approval on each 'who is' question, while the actions that matter stay behind their own confirmation and tool output reaches the model through Project-JARVIS's provenance boundary.\n\nThe language code becomes part of a host name, so it is accepted only as letters, digits and hyphens. Queries disclose to the Wikimedia Foundation what the user looks up; no identifier is sent beyond the request itself."
  },
